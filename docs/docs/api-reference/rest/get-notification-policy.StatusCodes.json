{"responses":{"200":{"description":"The current policy document.","content":{"application/json":{"schema":{"type":"object","description":"The versioned notification policy document (ADR 0017). Version 0 is the built-in default (every family NOBODY, publishedAt absent); a published version is immutable and every version is kept.","required":["version","rows"],"properties":{"version":{"type":"integer","minimum":0,"example":1},"rows":{"type":"array","minItems":7,"maxItems":7,"items":{"type":"object","description":"The decision of one family.","required":["family","notifier"],"properties":{"family":{"type":"string","enum":["DELAY_EXPECTED","ETA_WINDOW_ASSIGNED","DELIVERY_POINT_ADVISORY","GROUP_SHIPPED","GROUP_DELIVERED","GROUP_LOST","GROUP_RETURNED"]},"notifier":{"type":"string","enum":["MARKETPLACE","SELLER","NOBODY"]}},"title":"NotificationPolicyRow"}},"publishedAt":{"type":"string","format":"date-time","description":"Absent on version 0."}},"title":"NotificationPolicy"}}}}}}